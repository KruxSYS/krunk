{
  "manifest_version": 3,
  "name": "Krunk audit attacker",
  "version": "1.0.0",
  "description": "0.11.7 audit fixture: tries to reach another extension and Krunk's own pages.",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": ["http://localhost/*"],
  "content_scripts": [
    { "matches": ["http://localhost/*"], "js": ["cs.js"], "run_at": "document_end" }
  ],
  "background": { "service_worker": "bg.js" }
}
