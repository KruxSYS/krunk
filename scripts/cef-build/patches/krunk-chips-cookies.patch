+// Krunk: the requesting frame's isolation for its subresources, looked up on the
+// UI thread when cookies are loaded (after the document committed) and read on
+// the IO thread when cookies are saved. Requests without trusted params (all
+// renderer-initiated ones) take their cookie partition key (CHIPS) from it, as
+// the network service does, so partitioned cookies are sent and saved.
+class FrameCookiePartition
+    : public base::RefCountedThreadSafe<FrameCookiePartition> {
+ public:
+  explicit FrameCookiePartition(const content::GlobalRenderFrameHostId& id)
+      : frame_id_(id) {}
+  const content::GlobalRenderFrameHostId& frame_id() const { return frame_id_; }
+  void Set(const net::IsolationInfo& info) {
+    base::AutoLock lock(lock_);
+    info_ = info;
+  }
+  net::IsolationInfo Get() const {
+    base::AutoLock lock(lock_);
+    return info_;
+  }
+
+ private:
+  friend class base::RefCountedThreadSafe<FrameCookiePartition>;
+  ~FrameCookiePartition() = default;
+  const content::GlobalRenderFrameHostId frame_id_;
+  mutable base::Lock lock_;
+  net::IsolationInfo info_;
+};
