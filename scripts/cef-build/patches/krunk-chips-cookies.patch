+// Krunk: a request's cookie partition key as URLRequestHttpJob computes it.
+std::optional<net::CookiePartitionKey> PartitionKeyFrom(
+    const net::IsolationInfo& info,
+    const net::SiteForCookies& site_for_cookies,
+    const GURL& url) {
+  if (info.IsEmpty()) {
+    return std::nullopt;
+  }
+  return net::CookiePartitionKey::FromNetworkIsolationKey(
+      info.network_isolation_key(), site_for_cookies, net::SchemefulSite(url),
+      info.IsMainFrameRequest());
+}
