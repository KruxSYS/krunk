+namespace {
+
+// Krunk: pseudo-preferences, never registered or stored. They reach the engine
+// through the existing SetPreference API (no C API change).
+//   krunk.preconnect      string URL: what Chrome's omnibox does for its top
+//                         match (LoadingPredictor, HintOrigin::OMNIBOX). A no-op
+//                         in off-the-record profiles (no predictor) and with
+//                         net.network_prediction_options = 2; uses the
+//                         profile's network context, so its proxy.
+//   krunk.blocked_hosts   list of host strings: content::PreconnectManager's
+//                         blocked-host set (no preconnect / DNS pre-resolve).
+//   krunk.predictor_clear any value: forgets what the predictor learned.
+constexpr char kKrunkPreconnect[] = "krunk.preconnect";
+constexpr char kKrunkBlockedHosts[] = "krunk.blocked_hosts";
+constexpr char kKrunkPredictorClear[] = "krunk.predictor_clear";
+
+bool IsKrunkPref(const std::string& name) {
+  return name == kKrunkPreconnect || name == kKrunkBlockedHosts ||
+         name == kKrunkPredictorClear;
+}
+
+bool SetKrunkPref(Profile* profile,
+                  const std::string& name,
+                  CefRefPtr<CefValue> value,
+                  CefString& error) {
+  auto* predictor =
+      profile ? predictors::LoadingPredictorFactory::GetForProfile(profile)
+              : nullptr;
+  if (name == kKrunkBlockedHosts) {
+    std::vector<std::string> hosts;
+    if (value && value->GetType() == VTYPE_LIST) {
+      CefRefPtr<CefListValue> list = value->GetList();
+      hosts.reserve(list->GetSize());
+      for (size_t i = 0; i < list->GetSize(); ++i) {
+        hosts.push_back(list->GetString(i).ToString());
+      }
+    }
+    content::PreconnectManager::SetKrunkBlockedHosts(std::move(hosts));
+    return true;
+  }
+  if (name == kKrunkPredictorClear) {
+    if (predictor && predictor->resource_prefetch_predictor()) {
+      predictor->resource_prefetch_predictor()->DeleteAllUrls();
+    }
+    return true;
+  }
+  if (!value || value->GetType() != VTYPE_STRING) {
+    error = "krunk.preconnect needs a URL";
+    return false;
+  }
+  GURL url(value->GetString().ToString());
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS()) {
+    error = "krunk.preconnect needs an http(s) URL";
+    return false;
+  }
+  if (predictor) {
+    predictor->PrepareForPageLoad(std::nullopt, url,
+                                  predictors::HintOrigin::OMNIBOX,
+                                  network::GetNoOpNetworkRestrictionsId(),
+                                  /*preconnectable=*/true);
+  }
+  return true;
+}
+
+}  // namespace
