 namespace {
 
+// Krunk: the browser identity it presents by default. --krunk-ua-brand names the
+// brand listed next to "Chromium" and the GREASE brand (the user agent itself
+// comes from --user-agent-product), --krunk-ua-version the full version every
+// brand list and the full-version hint carry. Without them: the engine's own.
+std::string KrunkUaSwitch(const char* name) {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch(name)) {
+    return std::string();
+  }
+  std::string value = command_line->GetSwitchValueASCII(name);
+  return net::HttpUtil::IsValidHeaderValue(value) ? value : std::string();
+}
+
+std::string KrunkFullVersion() {
+  std::string full = KrunkUaSwitch("krunk-ua-version");
+  base::Version version(full);
+  if (!full.empty() && version.IsValid() && version.components().size() == 4) {
+    return full;
+  }
+  return std::string(version_info::GetVersionNumber());
+}
+
+std::string KrunkMajorVersion() {
+  std::string full = KrunkFullVersion();
+  return full.substr(0, full.find('.'));
+}
+
