 namespace content {
 
+// Krunk: the blocked-host set (PreconnectManager::SetKrunkBlockedHosts).
+namespace {
+struct KrunkBlocked {
+  base::Lock lock;
+  std::unordered_set<std::string> hosts;
+};
+KrunkBlocked& GetKrunkBlocked() {
+  static base::NoDestructor<KrunkBlocked> blocked;
+  return *blocked;
+}
+}  // namespace
+
+// static
+void PreconnectManager::SetKrunkBlockedHosts(std::vector<std::string> hosts) {
+  KrunkBlocked& b = GetKrunkBlocked();
+  base::AutoLock guard(b.lock);
+  b.hosts.clear();
+  for (auto& h : hosts) {
+    b.hosts.insert(base::ToLowerASCII(h));
+  }
+}
+
+// static
+bool PreconnectManager::IsKrunkBlocked(const GURL& url) {
+  if (!url.has_host()) {
+    return false;
+  }
+  KrunkBlocked& b = GetKrunkBlocked();
+  base::AutoLock guard(b.lock);
+  if (b.hosts.empty()) {
+    return false;
+  }
+  // a.b.tracker.com, b.tracker.com, tracker.com, com.
+  std::string host = base::ToLowerASCII(url.host());
+  std::string_view h(host);
+  while (!h.empty()) {
+    if (b.hosts.contains(std::string(h))) {
+      return true;
+    }
+    size_t dot = h.find('.');
+    if (dot == std::string_view::npos) {
+      break;
+    }
+    h.remove_prefix(dot + 1);
+  }
+  return false;
+}
+
 const bool kAllowCredentialsOnPreconnectByDefault = true;
 
