+// Krunk: middle-click in the Back/Forward history menu opens the entry in a new
+// tab that keeps the whole back/forward list. The new tab's controller takes a
+// copy of the source's entries (what Chrome's Duplicate does), then goes to the
+// chosen entry.
+Response PageHandler::KrunkCloneNavigationFrom(const std::string& target_id,
+                                               int entry_id) {
+  Response response = AssureTopLevelActiveFrame();
+  if (response.IsError()) {
+    return response;
+  }
+  scoped_refptr<DevToolsAgentHost> source_host =
+      DevToolsAgentHost::GetForId(target_id);
+  WebContents* source = source_host ? source_host->GetWebContents() : nullptr;
+  WebContents* target = WebContents::FromRenderFrameHost(host_);
+  if (!source || !target || source == target) {
+    return Response::InvalidParams("No other page with that target id");
+  }
+  // A private profile's history never goes to another profile.
+  if (source->GetBrowserContext() != target->GetBrowserContext()) {
+    return Response::ServerError("The pages belong to different profiles");
+  }
+  NavigationController& from = source->GetController();
+  int index = -1;
+  for (int i = 0; i != from.GetEntryCount(); ++i) {
+    if (from.GetEntryAtIndex(i)->GetUniqueID() == entry_id) {
+      index = i;
+      break;
+    }
+  }
+  if (index < 0) {
+    return Response::InvalidParams("No entry with passed id");
+  }
+  response = CheckNavigationAllowed(from.GetEntryAtIndex(index)->GetURL());
+  if (response.IsError()) {
+    return response;
+  }
+  NavigationController& to = target->GetController();
+  // Only a fresh page: its initial entry, or one about:blank, and nothing
+  // pending (CopyStateFrom replaces the whole list).
+  if (to.GetEntryCount() > 1 || to.GetPendingEntry() ||
+      (to.GetLastCommittedEntry() &&
+       !to.GetLastCommittedEntry()->IsInitialEntry() &&
+       !to.GetLastCommittedEntry()->GetURL().IsAboutBlank())) {
+    return Response::ServerError("This page has a history of its own");
+  }
+  to.CopyStateFrom(&from, /*needs_reload=*/true);
+  if (index == to.GetLastCommittedEntryIndex()) {
+    to.LoadIfNecessary();
+  } else {
+    to.GoToIndex(index);
+  }
+  return Response::Success();
+}
+
 static bool ReturnTrue(NavigationEntry* entry) {
   return true;
