+// Krunk: a windowed browser can be hidden (a background tab). Its visibility
+// follows the occlusion state of the WebContents' aura window
+// (WebContentsViewAura::GetVisibility), which stays VISIBLE for a child window
+// that the embedder only moves out of sight. Hiding that aura window makes the
+// occlusion tracker report HIDDEN, so WebContentsViewAura calls WasHidden()
+// itself (timers and animation frames throttled like a background tab in
+// Chrome) and keeps it hidden through later occlusion updates, such as the
+// top-level window being minimised and restored. Showing it reverses this.
+void CefBrowserPlatformDelegateNativeAura::WasHidden(bool hidden) {
+  if (!web_contents_) {
+    return;
+  }
+  aura::Window* window = web_contents_->GetNativeView();
+  if (!window) {
+    return;
+  }
+  if (hidden) {
+    window->Hide();
+  } else {
+    window->Show();
+  }
+}
