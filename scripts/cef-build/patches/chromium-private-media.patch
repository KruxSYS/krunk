@@ -92,6 +92,36 @@ void SystemMediaControlsNotifier::MediaSessionInfoChanged(
   bool is_playing = false;
 
   session_info_ptr_ = std::move(session_info_ptr);
+
+  // Krunk: media of a private (off-the-record) session never reaches the system's
+  // media controls: nothing of it is shown and they are off while it is active.
+  const bool hidden = session_info_ptr_ && session_info_ptr_->hide_metadata;
+  if (hidden) {
+    if (!hidden_session_) {
+      hidden_session_ = true;
+      delayed_metadata_update_ = std::nullopt;
+      delayed_position_update_ = std::nullopt;
+      delayed_playback_status_ = std::nullopt;
+      delayed_icon_update_ = std::nullopt;
+      system_media_controls_->SetPlaybackStatus(PlaybackStatus::kStopped);
+      ClearAllMetadata();
+      system_media_controls_->ClearPosition();
+      system_media_controls_->SetEnabled(false);
+    }
+    return;
+  }
+  if (hidden_session_) {
+    hidden_session_ = false;
+    system_media_controls_->SetEnabled(true);
+    // The artwork that came while hidden was dropped and the controller sends it
+    // only on changes: observe again, which delivers the current one.
+    media_controller_image_observer_receiver_.reset();
+    media_controller_remote_->ObserveImages(
+        media_session::mojom::MediaSessionImageType::kArtwork, kMinImageSize,
+        kDesiredImageSize,
+        media_controller_image_observer_receiver_.BindNewPipeAndPassRemote());
+  }
+
   if (session_info_ptr_) {
