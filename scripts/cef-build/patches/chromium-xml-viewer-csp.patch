+// Krunk: in a main frame the viewer is ordinary document content, so a <style> element would
+// be subject to the page's CSP: a site that sends `style-src 'self'` (common for sitemaps)
+// got an unstyled tree with the source text run together on top, in Chrome too. Inject the
+// viewer's own stylesheet the way extensions' insertCSS does instead; page CSP doesn't apply
+// to injected sheets. (Iframes use a user-agent shadow root, which is exempt already.)
+void InjectXMLViewerStyle(Document& document) {
+  auto* sheet = MakeGarbageCollected<StyleSheetContents>(
+      MakeGarbageCollected<CSSParserContext>(document));
+  sheet->ParseString(
+      UncompressResourceAsASCIIString(IDR_DOCUMENTXMLTREEVIEWER_CSS));
+  document.GetStyleEngine().InjectSheet(
+      StyleSheetKey("krunk-xml-tree-viewer"), sheet, WebCssOrigin::kAuthor);
+}
