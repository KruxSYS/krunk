+  std::string trigger_ = "menu";
+  bool open_sent_ = false;
+
+  // Video eligibility: "" when castable, else none|disabled|drm|codec|site.
+  std::string video_reason_ = "none";
+  std::string video_codec_;
+  std::string audio_codec_;
+
+  // This tab's current local route, if any.
+  std::optional<media_router::MediaRoute> route_;
+  std::unique_ptr<TabRoutesObserver> routes_observer_;
+  mojo::Remote<media_router::mojom::MediaController> route_controller_;
+  mojo::Receiver<media_router::mojom::MediaStatusObserver> status_receiver_;
+  media_router::mojom::MediaStatusPtr route_status_;
+
+  mojo::Receiver<media_session::mojom::MediaSessionObserver>
+      session_receiver_;
+  bool session_playing_ = false;
+  std::optional<media_session::MediaPosition> session_position_;
+
+  base::ScopedClosureRunner fullscreen_blocker_;
+
+  base::WeakPtrFactory<KrunkCastController> weak_ptr_factory_{this};
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+#endif  // CEF_LIBCEF_BROWSER_MEDIA_ROUTER_KRUNK_CAST_CONTROLLER_H_
