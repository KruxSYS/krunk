+KrunkCastController::KrunkCastController(content::WebContents* web_contents)
+    : content::WebContentsUserData<KrunkCastController>(*web_contents),
+      media_router::MediaRouterDialogController(web_contents),
+      status_receiver_(this),
+      session_receiver_(this) {
+  if (auto* router = media_router::MediaRouterFactory::GetApiForBrowserContext(
+          web_contents->GetBrowserContext())) {
+    routes_observer_ = std::make_unique<TabRoutesObserver>(router, this);
+  }
+}
