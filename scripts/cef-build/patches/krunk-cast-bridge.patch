+namespace {
+
+const char* ModeName(MediaCastMode mode) {
+  switch (mode) {
+    case MediaCastMode::PRESENTATION:
+      return "presentation";
+    case MediaCastMode::TAB_MIRROR:
+      return "tab";
+    case MediaCastMode::DESKTOP_MIRROR:
+      return "desktop";
+    case MediaCastMode::REMOTE_PLAYBACK:
+      return "video";
+  }
+  return "tab";
+}
+
+std::optional<MediaCastMode> ModeFromName(const std::string& name) {
+  if (name == "presentation") {
+    return MediaCastMode::PRESENTATION;
+  }
+  if (name == "tab") {
+    return MediaCastMode::TAB_MIRROR;
+  }
+  if (name == "video") {
+    return MediaCastMode::REMOTE_PLAYBACK;
+  }
+  // Desktop mirroring is not offered by Krunk.
+  return std::nullopt;
+}
+
+const char* StateName(UIMediaSinkState state) {
+  switch (state) {
+    case UIMediaSinkState::AVAILABLE:
+      return "available";
+    case UIMediaSinkState::CONNECTING:
+      return "connecting";
+    case UIMediaSinkState::CONNECTED:
+      return "connected";
+    case UIMediaSinkState::DISCONNECTING:
+      return "disconnecting";
+    case UIMediaSinkState::UNAVAILABLE:
+      return "unavailable";
+  }
+  return "unavailable";
+}
+
+const char* IconName(media_router::SinkIconType icon) {
+  switch (icon) {
+    case media_router::SinkIconType::CAST:
+      return "cast";
+    case media_router::SinkIconType::CAST_AUDIO_GROUP:
+      return "speakerGroup";
+    case media_router::SinkIconType::CAST_AUDIO:
+      return "speaker";
+    case media_router::SinkIconType::WIRED_DISPLAY:
+      return "display";
+    default:
+      return "generic";
+  }
+}
+
+const char* ProviderName(media_router::mojom::MediaRouteProviderId provider) {
+  switch (provider) {
+    case media_router::mojom::MediaRouteProviderId::CAST:
+      return "cast";
+    case media_router::mojom::MediaRouteProviderId::DIAL:
+      return "dial";
+    case media_router::mojom::MediaRouteProviderId::WIRED_DISPLAY:
+      return "wired";
+    default:
+      return "other";
+  }
+}
+
+const char* RouteMode(const media_router::MediaRoute& route) {
+  const auto& source = route.media_source();
+  if (source.IsTabMirroringSource()) {
+    return "tab";
+  }
+  if (source.IsRemotePlaybackSource()) {
+    return "video";
+  }
+  if (source.IsDesktopMirroringSource()) {
+    return "desktop";
+  }
+  return "presentation";
+}
+
+base::DictValue SinkToDict(const UIMediaSink& sink) {
+  base::DictValue d;
+  d.Set("id", sink.id);
+  d.Set("name", base::UTF16ToUTF8(sink.friendly_name));
+  d.Set("icon", IconName(sink.icon_type));
+  d.Set("provider", ProviderName(sink.provider));
+  d.Set("state", StateName(sink.state));
+  d.Set("status", base::UTF16ToUTF8(sink.GetStatusTextForDisplay()));
+  base::ListValue modes;
+  for (MediaCastMode mode : sink.cast_modes) {
+    if (mode != MediaCastMode::DESKTOP_MIRROR) {
+      modes.Append(ModeName(mode));
+    }
+  }
+  d.Set("modes", std::move(modes));
+  if (sink.route) {
+    d.Set("route", sink.route->media_route_id());
+    d.Set("routeMode", RouteMode(*sink.route));
+    d.Set("routeLocal", sink.route->is_local());
+  }
+  if (sink.issue) {
+    d.Set("issue", sink.issue->info().title);
+  }
+  return d;
+}
