+  KrunkCastController& operator=(const KrunkCastController&) = delete;
+  ~KrunkCastController() override;
+
+  // MediaRouterDialogController:
+  bool ShowMediaRouterDialogForPresentation(
+      std::unique_ptr<media_router::StartPresentationContext> context)
+      override;
+  void CreateMediaRouterDialog(
+      media_router::MediaRouterDialogActivationLocation activation_location)
+      override;
+  void CloseMediaRouterDialog() override;
+  bool IsShowingMediaRouterDialog() const override;
+  void Reset() override;
+
+  // mojom::MediaStatusObserver:
+  void OnMediaStatusUpdated(media_router::mojom::MediaStatusPtr status) override;
+
+  // media_session::mojom::MediaSessionObserver:
+  void MediaSessionInfoChanged(
+      media_session::mojom::MediaSessionInfoPtr info) override;
+  void MediaSessionMetadataChanged(
+      const std::optional<media_session::MediaMetadata>& metadata) override {}
+  void MediaSessionActionsChanged(
+      const std::vector<media_session::mojom::MediaSessionAction>& actions)
+      override {}
+  void MediaSessionImagesChanged(
+      const base::flat_map<media_session::mojom::MediaSessionImageType,
+                           std::vector<media_session::MediaImage>>& images)
+      override {}
+  void MediaSessionPositionChanged(
+      const std::optional<media_session::MediaPosition>& position) override;
+
+ private:
+  friend class content::WebContentsUserData<KrunkCastController>;
+  class TabRoutesObserver;
+  class UIObserver;
+
+  // From |ui_| (video == false) or |video_ui_| (video == true).
+  void OnModelUpdated(bool video, const media_router::CastDialogModel& model);
+
+  explicit KrunkCastController(content::WebContents* web_contents);
+
+  // Commands from the app.
+  void Open();
+  bool Start(const std::string& sink_id, const std::string& mode);
+  void Stop(const std::string& route_id);
+  void Media(const std::string& action, double value);
+
+  // Creates |ui_| (and |video_ui_| when the page's media can be remoted).
+  void InitializeUIs();
+  void DestroyUIs();
+  void OnVideoUIDestroyed();
+  void OnUIDestroyed();
+
+  // Video (media remoting) eligibility from the media session.
+  void UpdateVideoEligibility();
+
+  void OnRoutesUpdated(const std::vector<media_router::MediaRoute>& routes);
+
+  base::DictValue BuildModel() const;
+  base::DictValue BuildState() const;
+  void SendModel(const char* name);
+  void SendState();
+  void Send(const char* name, const base::DictValue& payload);
+
+  bool EnsureMediaSessionObserver();
+
+  int tab_id() const;
+
+  std::unique_ptr<media_router::MediaRouterUI> ui_;
+  std::unique_ptr<media_router::MediaRouterUI> video_ui_;
+  std::unique_ptr<UIObserver> ui_observer_;
+  std::unique_ptr<UIObserver> video_ui_observer_;
+  std::optional<media_router::CastDialogModel> model_;
+  std::optional<media_router::CastDialogModel> video_model_;
+  // "page" when a site asked (Presentation API / Remote Playback), else
