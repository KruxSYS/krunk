+// static
+void KrunkCastController::Register() {
+  media_router::MediaRouterDialogController::SetGetOrCreate(
+      base::BindRepeating([](content::WebContents* web_contents)
+                              -> media_router::MediaRouterDialogController* {
+        DCHECK(web_contents);
+        KrunkCastController::CreateForWebContents(web_contents);
+        return KrunkCastController::FromWebContents(web_contents);
+      }));
+}
+
+// static
+bool KrunkCastController::HandleCommand(CefRefPtr<CefValue> value,
+                                        std::string& error) {
+  CEF_REQUIRE_UIT();
+  if (!value || value->GetType() != VTYPE_DICTIONARY) {
+    error = "krunk.cast needs a dictionary";
+    return false;
+  }
+  CefRefPtr<CefDictionaryValue> dict = value->GetDictionary();
+  const std::string cmd = dict->GetString("cmd").ToString();
+  const int browser_id = dict->GetInt("browser");
+  auto browser = CefBrowserHostBase::GetBrowserForBrowserId(browser_id);
+  content::WebContents* web_contents =
+      browser ? browser->GetWebContents() : nullptr;
+  if (!web_contents) {
+    error = "krunk.cast: no such browser";
+    return false;
+  }
+  if (!media_router::MediaRouterEnabled(web_contents->GetBrowserContext())) {
+    error = "krunk.cast: casting is turned off";
+    return false;
+  }
+
+  KrunkCastController::CreateForWebContents(web_contents);
+  KrunkCastController* controller =
+      KrunkCastController::FromWebContents(web_contents);
+
+  if (cmd == "open") {
+    controller->Open();
+    return true;
+  }
+  if (cmd == "start") {
+    if (!controller->Start(dict->GetString("sink").ToString(),
+                           dict->GetString("mode").ToString())) {
+      error = "krunk.cast: cannot start (picker closed or unknown mode)";
+      return false;
+    }
+    return true;
+  }
+  if (cmd == "stop") {
+    controller->Stop(dict->GetString("route").ToString());
+    return true;
+  }
+  if (cmd == "close") {
+    controller->HideMediaRouterDialog();
+    return true;
+  }
+  if (cmd == "media") {
+    controller->Media(dict->GetString("action").ToString(),
+                      dict->HasKey("value") ? dict->GetDouble("value") : 0);
+    return true;
+  }
+  error = "krunk.cast: unknown command";
+  return false;
+}
