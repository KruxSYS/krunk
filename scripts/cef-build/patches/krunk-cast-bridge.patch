+// Follows the profile's routes for this tab (the toolbar icon and the
+// picker's controls need them while the picker is closed).
+class KrunkCastController::TabRoutesObserver
+    : public media_router::MediaRoutesObserver {
+ public:
+  TabRoutesObserver(media_router::MediaRouter* router,
+                    KrunkCastController* owner)
+      : media_router::MediaRoutesObserver(router), owner_(owner) {}
+
+  void OnRoutesUpdated(
+      const std::vector<media_router::MediaRoute>& routes) override {
+    owner_->OnRoutesUpdated(routes);
+  }
+
+ private:
+  const raw_ptr<KrunkCastController> owner_;
+};
