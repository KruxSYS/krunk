+// Tells the two MediaRouterUIs' model updates apart.
+class KrunkCastController::UIObserver
+    : public media_router::CastDialogController::Observer {
+ public:
+  UIObserver(KrunkCastController* owner, bool video)
+      : owner_(owner), video_(video) {}
+
+  void OnModelUpdated(const media_router::CastDialogModel& model) override {
+    owner_->OnModelUpdated(video_, model);
+  }
+
+ private:
+  const raw_ptr<KrunkCastController> owner_;
+  const bool video_;
+};
