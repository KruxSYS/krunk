+KrunkCastController::~KrunkCastController() {
+  Reset();
+}
+
+int KrunkCastController::tab_id() const {
+  return sessions::SessionTabHelper::IdForTab(&GetWebContents()).id();
+}
+
+bool KrunkCastController::ShowMediaRouterDialogForPresentation(
+    std::unique_ptr<media_router::StartPresentationContext> context) {
+  // Same rule as Chrome: no picker over attacker-controlled fullscreen.
+  base::WeakPtr<KrunkCastController> weak_this = weak_ptr_factory_.GetWeakPtr();
+  auto blocker =
+      initiator()->ForSecurityDropFullscreen(display::kInvalidDisplayId);
+  if (!weak_this || !blocker) {
+    return false;
+  }
+  if (IsShowingMediaRouterDialog()) {
+    // A page request replaces a menu-opened picker.
+    CloseMediaRouterDialog();
+    Reset();
+  }
+  fullscreen_blocker_ = std::move(*blocker);
+  trigger_ = "page";
+  return media_router::MediaRouterDialogController::
+      ShowMediaRouterDialogForPresentation(std::move(context));
+}
+
+void KrunkCastController::Open() {
+  if (IsShowingMediaRouterDialog()) {
+    // Already open (e.g. a page request): send the model again.
+    SendModel("krunk.cast.open");
+    return;
+  }
+  trigger_ = "menu";
+  ShowMediaRouterDialog(
+      media_router::MediaRouterDialogActivationLocation::TOOLBAR);
+}
+
+void KrunkCastController::CreateMediaRouterDialog(
+    media_router::MediaRouterDialogActivationLocation activation_location) {
+  open_sent_ = false;
+  InitializeUIs();
+  SendModel("krunk.cast.open");
+  open_sent_ = true;
+}
+
+void KrunkCastController::UpdateVideoEligibility() {
+  video_reason_ = "none";
+  video_codec_.clear();
+  audio_codec_.clear();
+  auto* session = content::MediaSession::GetIfExists(&GetWebContents());
+  if (!session) {
+    return;
+  }
+  media_session::mojom::MediaSessionInfoPtr info;
+  // MediaSessionImpl answers synchronously.
+  session->GetMediaSessionInfo(base::BindOnce(
+      [](media_session::mojom::MediaSessionInfoPtr* out,
+         media_session::mojom::MediaSessionInfoPtr in) { *out = std::move(in); },
+      &info));
+  if (!info || !info->remote_playback_metadata) {
+    return;
+  }
+  const auto& meta = info->remote_playback_metadata;
+  if (meta->is_encrypted_media) {
+    video_reason_ = "drm";
+    return;
+  }
+  if (meta->remote_playback_disabled) {
+    video_reason_ = "disabled";
+    return;
+  }
+  if (media::remoting::ParseVideoCodec(meta->video_codec) ==
+          media::VideoCodec::kUnknown ||
+      media::remoting::ParseAudioCodec(meta->audio_codec) ==
+          media::AudioCodec::kUnknown) {
+    video_reason_ = "codec";
+    return;
+  }
+  auto presentation_manager =
+      media_router::WebContentsPresentationManager::Get(&GetWebContents());
+  if (presentation_manager &&
+      presentation_manager->HasDefaultPresentationRequest()) {
+    // The site has its own Cast integration (e.g. YouTube): its
+    // "presentation" mode is the way to cast its video.
+    video_reason_ = "site";
+    return;
+  }
+  video_reason_.clear();
+  video_codec_ = meta->video_codec;
+  audio_codec_ = meta->audio_codec;
+}
+
+void KrunkCastController::InitializeUIs() {
+  DestroyUIs();
+  ui_ = start_presentation_context_
+            ? media_router::MediaRouterUI::
+                  CreateWithStartPresentationContextAndMirroring(
+                      initiator(), std::move(start_presentation_context_))
+            : media_router::MediaRouterUI::
+                  CreateWithDefaultMediaSourceAndMirroring(initiator());
+  ui_->RegisterDestructor(base::BindOnce(&KrunkCastController::OnUIDestroyed,
+                                         base::Unretained(this)));
+  ui_observer_ = std::make_unique<UIObserver>(this, /*video=*/false);
+  ui_->AddObserver(ui_observer_.get());
+
+  UpdateVideoEligibility();
+  if (video_reason_.empty()) {
+    video_ui_ = media_router::MediaRouterUI::CreateWithMediaSessionRemotePlayback(
+        initiator(), media::remoting::ParseVideoCodec(video_codec_),
+        media::remoting::ParseAudioCodec(audio_codec_));
+    video_ui_->RegisterDestructor(base::BindOnce(
+        &KrunkCastController::OnVideoUIDestroyed, base::Unretained(this)));
+    video_ui_observer_ = std::make_unique<UIObserver>(this, /*video=*/true);
+    video_ui_->AddObserver(video_ui_observer_.get());
+  }
+}
+
+void KrunkCastController::DestroyUIs() {
+  if (video_ui_) {
+    video_ui_->RemoveObserver(video_ui_observer_.get());
+    video_ui_.reset();
+  }
+  if (ui_) {
+    ui_->RemoveObserver(ui_observer_.get());
+    ui_.reset();
+  }
+  video_ui_observer_.reset();
+  ui_observer_.reset();
+  model_.reset();
+  video_model_.reset();
+}
+
+void KrunkCastController::OnUIDestroyed() {
+  ui_.reset();
+  model_.reset();
+}
+
+void KrunkCastController::OnVideoUIDestroyed() {
+  video_ui_.reset();
+  video_model_.reset();
+}
+
+void KrunkCastController::CloseMediaRouterDialog() {
+  // Also called by the base class when the tab navigates, closes or crashes
+  // (Chrome closes its dialog then too). There is no widget whose destruction
+  // would reset the state later, so reset it here.
+  const bool was_showing = IsShowingMediaRouterDialog();
+  Reset();
+  if (was_showing) {
+    Send("krunk.cast.closed", base::DictValue());
+  }
+}
+
+bool KrunkCastController::IsShowingMediaRouterDialog() const {
+  return !!ui_;
+}
+
+void KrunkCastController::Reset() {
+  DestroyUIs();
+  trigger_ = "menu";
+  open_sent_ = false;
+  fullscreen_blocker_.RunAndReset();
+  media_router::MediaRouterDialogController::Reset();
+}
+
+bool KrunkCastController::Start(const std::string& sink_id,
+                                const std::string& mode_name) {
+  auto mode = ModeFromName(mode_name);
+  if (!mode) {
+    return false;
+  }
+  media_router::MediaRouterUI* ui =
+      *mode == MediaCastMode::REMOTE_PLAYBACK ? video_ui_.get() : ui_.get();
+  if (!ui) {
+    return false;
+  }
+  ui->StartCasting(sink_id, *mode);
+  return true;
+}
+
+void KrunkCastController::Stop(const std::string& route_id) {
+  if (ui_) {
+    ui_->StopCasting(route_id);
+    return;
+  }
+  if (auto* router = media_router::MediaRouterFactory::GetApiForBrowserContext(
+          GetWebContents().GetBrowserContext())) {
+    router->TerminateRoute(route_id);
+  }
+}
+
+void KrunkCastController::Media(const std::string& action, double value) {
+  // A Cast app session (e.g. a site's receiver) has its own media controller;
+  // mirroring and remote playback are controlled through the page's media.
+  const bool remote = route_controller_.is_bound() && route_status_;
+  if (action == "play" || action == "pause") {
+    if (remote && route_status_->can_play_pause) {
+      action == "play" ? route_controller_->Play() : route_controller_->Pause();
+      return;
+    }
+    if (auto* session = content::MediaSession::Get(&GetWebContents())) {
+      action == "play"
+          ? session->Resume(media_session::mojom::MediaSession::SuspendType::kUI)
+          : session->Suspend(media_session::mojom::MediaSession::SuspendType::kUI);
+    }
+    return;
+  }
+  if (action == "seek") {
+    const base::TimeDelta to = base::Seconds(std::max(0.0, value));
+    if (remote && route_status_->can_seek) {
+      route_controller_->Seek(to);
+      return;
+    }
+    if (auto* session = content::MediaSession::Get(&GetWebContents())) {
+      session->SeekTo(to);
+    }
+    return;
+  }
+  if (remote && action == "volume" && route_status_->can_set_volume) {
+    route_controller_->SetVolume(
+        static_cast<float>(std::clamp(value, 0.0, 1.0)));
+    return;
+  }
+  if (remote && action == "mute" && route_status_->can_mute) {
+    route_controller_->SetMute(value != 0);
+  }
+}
+
+void KrunkCastController::OnModelUpdated(
+    bool video,
+    const media_router::CastDialogModel& model) {
+  if (video) {
+    video_model_ = model;
+  } else {
+    model_ = model;
+  }
+  if (open_sent_) {
+    SendModel("krunk.cast.model");
+  }
+}
+
+base::DictValue KrunkCastController::BuildModel() const {
+  base::DictValue d;
+  d.Set("trigger", trigger_);
+  d.Set("private", initiator()->GetBrowserContext()->IsOffTheRecord());
+  base::DictValue video;
+  video.Set("castable", video_reason_.empty());
+  video.Set("reason", video_reason_);
+  d.Set("video", std::move(video));
+  if (model_) {
+    d.Set("header", base::UTF16ToUTF8(model_->dialog_header()));
+  }
+
+  // One list: the tab/page model, with REMOTE_PLAYBACK added from the video
+  // model for the sinks that can play this page's video.
+  base::ListValue sinks;
+  std::vector<std::string> seen;
+  if (model_) {
+    for (const auto& sink : model_->media_sinks()) {
+      UIMediaSink merged = sink;
+      if (video_model_) {
+        for (const auto& v : video_model_->media_sinks()) {
+          if (v.id == sink.id &&
+              v.cast_modes.count(MediaCastMode::REMOTE_PLAYBACK)) {
+            merged.cast_modes.insert(MediaCastMode::REMOTE_PLAYBACK);
+            if (!merged.route && v.route) {
+              merged.route = v.route;
+              merged.state = v.state;
+            }
+          }
+        }
+      }
+      seen.push_back(sink.id);
+      sinks.Append(SinkToDict(merged));
+    }
+  }
+  if (video_model_) {
+    for (const auto& v : video_model_->media_sinks()) {
+      if (std::find(seen.begin(), seen.end(), v.id) == seen.end()) {
+        sinks.Append(SinkToDict(v));
+      }
+    }
+  }
+  d.Set("sinks", std::move(sinks));
+  return d;
+}
+
+void KrunkCastController::SendModel(const char* name) {
+  base::DictValue d = BuildModel();
+  d.Set("state", BuildState());
+  Send(name, d);
+}
+
+base::DictValue KrunkCastController::BuildState() const {
+  base::DictValue d;
+  d.Set("casting", route_.has_value());
+  if (!route_) {
+    return d;
+  }
+  d.Set("route", route_->media_route_id());
+  d.Set("sink", route_->media_sink_name());
+  d.Set("mode", RouteMode(*route_));
+  d.Set("connecting", route_->is_connecting());
+  base::DictValue media;
+  if (route_status_) {
+    media.Set("title", route_status_->title);
+    media.Set("playing", route_status_->play_state ==
+                             media_router::mojom::MediaStatus::PlayState::PLAYING);
+    media.Set("canPlayPause", route_status_->can_play_pause);
+    media.Set("canSeek", route_status_->can_seek);
+    media.Set("canVolume", route_status_->can_set_volume);
+    media.Set("canMute", route_status_->can_mute);
+    media.Set("volume", route_status_->volume);
+    media.Set("muted", route_status_->is_muted);
+    media.Set("time", route_status_->current_time.InSecondsF());
+    media.Set("duration", route_status_->duration.InSecondsF());
+  } else {
+    // Mirroring / remote playback: the page's media session.
+    media.Set("playing", session_playing_);
+    media.Set("canPlayPause", true);
+    media.Set("canSeek", session_position_.has_value());
+    media.Set("canVolume", false);
+    media.Set("canMute", false);
+    if (session_position_) {
+      media.Set("time", session_position_->GetPosition().InSecondsF());
+      media.Set("duration", session_position_->duration().InSecondsF());
+    }
+  }
+  d.Set("media", std::move(media));
+  return d;
+}
+
+void KrunkCastController::SendState() {
+  Send("krunk.cast.state", BuildState());
+}
+
+void KrunkCastController::Send(const char* name,
+                               const base::DictValue& payload) {
+  auto browser = CefBrowserHostBase::GetBrowserForContents(&GetWebContents());
+  if (!browser) {
+    return;
+  }
+  CefRefPtr<CefClient> client = browser->GetClient();
+  CefRefPtr<CefFrame> frame = browser->GetMainFrame();
+  if (!client || !frame) {
+    return;
+  }
+  base::DictValue with_id = payload.Clone();
+  with_id.Set("browser", browser->GetIdentifier());
+  std::string json = base::WriteJson(with_id).value_or("{}");
+  CefRefPtr<CefProcessMessage> message = CefProcessMessage::Create(name);
+  message->GetArgumentList()->SetString(0, json);
+  client->OnProcessMessageReceived(browser.get(), frame, PID_BROWSER, message);
+}
+
+void KrunkCastController::OnRoutesUpdated(
+    const std::vector<media_router::MediaRoute>& routes) {
+  const int id = tab_id();
+  std::vector<media_router::MediaRoute::Id> presentation_routes;
+  if (auto manager =
+          media_router::WebContentsPresentationManager::Get(&GetWebContents())) {
+    for (const auto& r : manager->GetMediaRoutes()) {
+      presentation_routes.push_back(r.media_route_id());
+    }
+  }
+  std::optional<media_router::MediaRoute> found;
+  for (const auto& route : routes) {
+    if (!route.is_local()) {
+      continue;
+    }
+    const auto& source = route.media_source();
+    const bool mine =
+        (source.IsTabMirroringSource() && source.TabId() == id) ||
+        (source.IsRemotePlaybackSource() &&
+         source.TabIdFromRemotePlaybackSource() == id) ||
+        std::find(presentation_routes.begin(), presentation_routes.end(),
+                  route.media_route_id()) != presentation_routes.end();
+    if (mine) {
+      found = route;
+      break;
+    }
+  }
+
+  const bool changed_route =
+      found.has_value() != route_.has_value() ||
+      (found && route_ && found->media_route_id() != route_->media_route_id());
+  const bool changed_details =
+      found && route_ && found->is_connecting() != route_->is_connecting();
+  route_ = found;
+  if (changed_route) {
+    route_controller_.reset();
+    status_receiver_.reset();
+    route_status_.reset();
+    if (route_) {
+      if (auto* router =
+              media_router::MediaRouterFactory::GetApiForBrowserContext(
+                  GetWebContents().GetBrowserContext())) {
+        router->GetMediaController(
+            route_->media_route_id(),
+            route_controller_.BindNewPipeAndPassReceiver(),
+            status_receiver_.BindNewPipeAndPassRemote());
+        route_controller_.reset_on_disconnect();
+        status_receiver_.set_disconnect_handler(base::BindOnce(
+            [](KrunkCastController* self) {
+              self->status_receiver_.reset();
+              self->route_status_.reset();
+            },
+            base::Unretained(this)));
+      }
+      EnsureMediaSessionObserver();
+    }
+  }
+  if (changed_route || changed_details) {
+    SendState();
+  }
+}
+
+bool KrunkCastController::EnsureMediaSessionObserver() {
+  if (session_receiver_.is_bound()) {
+    return true;
+  }
+  auto* session = content::MediaSession::Get(&GetWebContents());
+  if (!session) {
+    return false;
+  }
+  session->AddObserver(session_receiver_.BindNewPipeAndPassRemote());
+  return true;
+}
+
+void KrunkCastController::OnMediaStatusUpdated(
+    media_router::mojom::MediaStatusPtr status) {
+  route_status_ = std::move(status);
+  SendState();
+}
+
+void KrunkCastController::MediaSessionInfoChanged(
+    media_session::mojom::MediaSessionInfoPtr info) {
+  const bool playing =
+      info && info->playback_state ==
+                  media_session::mojom::MediaPlaybackState::kPlaying;
+  if (playing != session_playing_) {
+    session_playing_ = playing;
+    if (route_ && !route_status_) {
+      SendState();
+    }
+  }
+}
+
+void KrunkCastController::MediaSessionPositionChanged(
+    const std::optional<media_session::MediaPosition>& position) {
+  session_position_ = position;
+  if (route_ && !route_status_) {
+    SendState();
+  }
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(KrunkCastController);
