{
  "manifest_version": 2,
  "name": "Krunk guard",
  "version": "1.0",
  "description": "Krunk's own companion to the bundled blocker: keeps the blocker's network requests behind a gate, passes Krunk's settings to it through the blocker's own messaging, and removes tracking parameters from top-level navigations.",
  "browser_specific_settings": { "gecko": { "id": "guard@krunk.org" } },
  "permissions": [
    "nativeMessaging",
    "geckoViewAddons",
    "mozillaAddons",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "background": { "scripts": ["background.js"] },
  "experiment_apis": {
    "krunkGate": {
      "schema": "gate-schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "script": "gate-api.js",
        "paths": [["krunkGate"]],
        "events": ["startup"]
      }
    },
    "krunkBridge": {
      "schema": "bridge-schema.json",
      "child": {
        "scopes": ["addon_child"],
        "script": "bridge-api.js",
        "paths": [["krunkBridge"]]
      }
    }
  }
}
