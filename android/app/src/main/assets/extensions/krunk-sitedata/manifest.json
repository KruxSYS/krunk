{
  "manifest_version": 2,
  "name": "Krunk site data",
  "version": "1.1",
  "description": "Tells Krunk, when its site data screen asks, which sites have cookies and how much data each site has stored. Reads names and sizes only, never cookie values or stored content, and makes no network requests.",
  "browser_specific_settings": {
    "gecko": {
      "id": "sitedata@krunk.org"
    }
  },
  "incognito": "not_allowed",
  "permissions": [
    "nativeMessaging",
    "geckoViewAddons",
    "cookies",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "sitedata.js",
      "background.js"
    ]
  },
  "experiment_apis": {
    "krunkSiteData": {
      "schema": "usage-schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "script": "usage-api.js",
        "paths": [
          [
            "krunkSiteData"
          ]
        ]
      }
    }
  }
}
