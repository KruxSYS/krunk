<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8-11 (one rule set for cloud backup and device transfer): nothing of Krunk is backed
     up. Bookmarks and settings live in the same database file as the browsing history, the open
     tabs and their saved state (files/krunk/browser.db), so the file cannot be backed up without
     them, and these rules cannot require an encrypted backup for it. The Gecko profile
     (cookies, site data, caches) was never included. Use Bookmarks > Export to move bookmarks. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <!-- The password vault (files/krunk-vault, VaultFiles.DIR) never leaves the device: the
         Keystore key that wraps its key cannot be moved, so a copy would be useless, and it is
         a secret store. Named here on its own so that no later include can carry it along. -->
    <exclude domain="file" path="krunk-vault" />
    <!-- Part files of downloads (files/downloads-part, DownloadEngine.PART_DIR): unfinished
         pieces, also of private downloads; deleted at the next start when nobody owns them. -->
    <exclude domain="file" path="downloads-part" />
</full-backup-content>
