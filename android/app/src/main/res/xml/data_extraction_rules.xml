<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Cloud backup: nothing (see backup_rules.xml for why the database is all or
     nothing). Device-to-device transfer (a direct, local copy to the user's new phone): Krunk's
     own data directory, i.e. bookmarks, history, settings and the open tabs. The Gecko profile
     (cookies, site data, caches) is not part of either. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <!-- The password vault (files/krunk-vault, VaultFiles.DIR) never leaves the device: the
             Keystore key that wraps its key cannot be moved, so a copy would be useless, and it is
             a secret store. Named here on its own so that no later include can carry it along. -->
        <exclude domain="file" path="krunk-vault" />
        <!-- Part files of downloads (files/downloads-part, DownloadEngine.PART_DIR): unfinished
             pieces, also of private downloads; deleted at the next start when nobody owns them. -->
        <exclude domain="file" path="downloads-part" />
        <!-- Krunk account and sync (files/krunk-sync, SyncController.dir, 0.6.0): the sign-in
             and sync's keys, wrapped by a Keystore key that never leaves the device. Named on its
             own so that no later include can carry it along. -->
        <exclude domain="file" path="krunk-sync" />
        <!-- The VPN (files/krunk-vpn, VpnStore.DIR, 0.10.0): profiles and credentials, wrapped
             by a Keystore key that never leaves the device; never synced. Named on its own so
             that no later include can carry it along. -->
        <exclude domain="file" path="krunk-vpn" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="krunk" />
        <!-- The password vault (files/krunk-vault, VaultFiles.DIR) never leaves the device: the
             Keystore key that wraps its key cannot be moved, so a copy would be useless, and it is
             a secret store. Named here on its own so that no later include can carry it along. -->
        <exclude domain="file" path="krunk-vault" />
        <!-- Part files of downloads (files/downloads-part) lie beside files/krunk, the only
             directory included here, so they are not transferred. (Lint refuses an exclude of a
             path that no include covers.) -->
        <!-- Krunk account and sync (files/krunk-sync, 0.6.0) lies beside files/krunk too, so it
             stays on this device: the new phone signs in again. The transferred browser.db
             carries sync's bookkeeping without the keys; KrunkSync forgets it at the first start. -->
        <!-- The VPN (files/krunk-vpn, 0.10.0) lies beside files/krunk too, so it stays on this
             device: profiles are imported again on the new phone. -->
    </device-transfer>
</data-extraction-rules>
