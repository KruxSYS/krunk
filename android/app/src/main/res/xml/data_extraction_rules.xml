<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: cloud backup and device-to-device transfer carry Krunk's own data directory
     minus the vault; the Gecko profile is not included (see backup_rules.xml). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="krunk" />
        <exclude domain="file" path="krunk/vault" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="krunk" />
        <exclude domain="file" path="krunk/vault" />
    </device-transfer>
</data-extraction-rules>
