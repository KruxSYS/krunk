<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: same rules for cloud backup and device-to-device transfer (see backup_rules.xml). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="krunk" />
        <exclude domain="file" path="krunk/vault" />
        <exclude domain="file" path="mozilla" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="krunk" />
        <exclude domain="file" path="krunk/vault" />
        <exclude domain="file" path="mozilla" />
    </device-transfer>
</data-extraction-rules>
