{
  "about": "Userscript address matching (0.12.0): core::userscripts::matches_url and the JS twin in ui/inject/userscript-loader.js (usMatches) must both give `expected`. @match: Chrome match patterns; @include/@exclude: whole-address * globs without the #fragment; @exclude wins; never on Krunk's own origins or other schemes.",
  "cases": [
    { "url": "https://example.com/", "matches": ["https://example.com/*"], "expected": true, "note": "match: plain" },
    { "url": "https://example.com/a/b?x=1", "matches": ["https://example.com/*"], "expected": true, "note": "match: path and query" },
    { "url": "http://example.com/", "matches": ["https://example.com/*"], "expected": false, "note": "match: scheme differs" },
    { "url": "http://example.com/", "matches": ["*://example.com/*"], "expected": true, "note": "match: * scheme is http" },
    { "url": "https://example.com/", "matches": ["*://example.com/*"], "expected": true, "note": "match: * scheme is https" },
    { "url": "https://www.example.com/", "matches": ["*://example.com/*"], "expected": false, "note": "match: exact host, no subdomain" },
    { "url": "https://www.example.com/", "matches": ["*://*.example.com/*"], "expected": true, "note": "match: subdomain" },
    { "url": "https://example.com/", "matches": ["*://*.example.com/*"], "expected": true, "note": "match: *. includes the domain itself" },
    { "url": "https://badexample.com/", "matches": ["*://*.example.com/*"], "expected": false, "note": "match: suffix without a dot" },
    { "url": "https://example.com.evil.test/", "matches": ["*://*.example.com/*"], "expected": false, "note": "match: domain as a prefix" },
    { "url": "https://anything.test/x", "matches": ["*://*/*"], "expected": true, "note": "match: all hosts" },
    { "url": "https://anything.test/x", "matches": ["<all_urls>"], "expected": true, "note": "match: <all_urls>" },
    { "url": "file:///C:/pages/a.html", "matches": ["<all_urls>"], "expected": false, "note": "match: <all_urls> is http(s) only" },
    { "url": "https://example.com:8443/a", "matches": ["https://example.com/*"], "expected": true, "note": "match: any port" },
    { "url": "https://example.com:8443/a", "matches": ["https://example.com:8443/*"], "expected": false, "note": "match: a port in the pattern is invalid" },
    { "url": "https://EXAMPLE.com/A", "matches": ["https://example.com/A"], "expected": true, "note": "match: host case is normalised, path exact" },
    { "url": "https://example.com/a", "matches": ["https://example.com/A"], "expected": false, "note": "match: path is case-sensitive" },
    { "url": "https://example.com/a", "matches": ["https://Example.COM/a"], "expected": true, "note": "match: pattern host lower-cased" },
    { "url": "https://example.com/foo/bar", "matches": ["https://example.com/foo*"], "expected": true, "note": "match: path glob" },
    { "url": "https://example.com/bar/foo", "matches": ["https://example.com/foo*"], "expected": false, "note": "match: path glob anchored" },
    { "url": "https://example.com/page?id=5", "matches": ["https://example.com/page?id=*"], "expected": true, "note": "match: query in the path glob" },
    { "url": "https://example.com/page#top", "matches": ["https://example.com/page"], "expected": true, "note": "match: fragment ignored" },
    { "url": "https://example.com/page?", "matches": ["https://example.com/page?"], "expected": true, "note": "match: empty query kept" },
    { "url": "https://example.com/page?", "matches": ["https://example.com/page"], "expected": false, "note": "match: empty query differs" },
    { "url": "https://example.com", "matches": ["https://example.com"], "expected": true, "note": "match: no path means /" },
    { "url": "https://example.com/x", "matches": ["https://example.com"], "expected": false, "note": "match: no path means exactly /" },
    { "url": "file:///C:/pages/a.html", "matches": ["file:///*"], "expected": true, "note": "match: file" },
    { "url": "file:///C:/pages/a.html", "matches": ["file:///C:/pages/*.html"], "expected": true, "note": "match: file path glob" },
    { "url": "https://example.com/", "matches": ["https://*example.com/*"], "expected": false, "note": "match: * inside a host is invalid" },
    { "url": "https://example.com/", "matches": ["example.com"], "expected": false, "note": "match: not a pattern" },
    { "url": "https://user@example.com/", "matches": ["https://example.com/*"], "expected": true, "note": "match: user info is not the host" },
    { "url": "http://[::1]:8080/x", "matches": ["http://[::1]/*"], "expected": false, "note": "match: an IPv6 host has ':' (invalid pattern)" },
    { "url": "http://127.0.0.1:3000/app", "matches": ["http://127.0.0.1/*"], "expected": true, "note": "match: IPv4 host" },
    { "url": "https://example.com/", "includes": ["*"], "expected": true, "note": "include: * alone" },
    { "url": "file:///home/a.html", "includes": ["*"], "expected": true, "note": "include: * on file:" },
    { "url": "http://news.example.net/today", "includes": ["http*://news.example.net/*"], "expected": true, "note": "include: http*://" },
    { "url": "https://news.example.net/today", "includes": ["http*://news.example.net/*"], "expected": true, "note": "include: http*:// https" },
    { "url": "https://example.com/a?q=1", "includes": ["*example.com/a?q=*"], "expected": true, "note": "include: whole address" },
    { "url": "https://example.com/a#frag", "includes": ["*#frag"], "expected": false, "note": "include: the fragment is not seen" },
    { "url": "https://example.com/a#frag", "includes": ["https://example.com/a"], "expected": true, "note": "include: without the fragment" },
    { "url": "https://example.com", "includes": ["https://example.com/"], "expected": true, "note": "include: the normalised address has the /" },
    { "url": "https://EXAMPLE.COM/Path", "includes": ["https://example.com/Path"], "expected": true, "note": "include: host normalised" },
    { "url": "https://example.com/path", "includes": ["https://example.com/PATH"], "expected": false, "note": "include: glob is case-sensitive" },
    { "url": "https://example.com:8080/", "includes": ["https://example.com/*"], "expected": false, "note": "include: the port is part of the address" },
    { "url": "https://example.com:8080/", "includes": ["https://example.com:8080/*"], "expected": true, "note": "include: with the port" },
    { "url": "https://example.com:443/", "includes": ["https://example.com/"], "expected": true, "note": "include: the default port is dropped" },
    { "url": "https://example.com/", "includes": ["/example\\.com/"], "expected": false, "note": "include: a regular expression never matches" },
    { "url": "https://example.com/", "includes": ["/example/i", "*example.com*"], "expected": true, "note": "include: a regex is skipped, the glob counts" },
    { "url": "https://example.com/a b", "includes": ["https://example.com/a%20b"], "expected": true, "note": "include: the address is percent-encoded" },
    { "url": "https://example.com/", "includes": ["*.example.com/*"], "expected": false, "note": "include: glob is literal, no subdomain magic" },
    { "url": "https://example.com/admin/x", "matches": ["https://example.com/*"], "excludes": ["*://example.com/admin*"], "expected": false, "note": "exclude wins over match" },
    { "url": "https://example.com/user/x", "matches": ["https://example.com/*"], "excludes": ["*://example.com/admin*"], "expected": true, "note": "exclude elsewhere" },
    { "url": "https://example.com/logout", "includes": ["*"], "excludes": ["*logout*"], "expected": false, "note": "exclude wins over include" },
    { "url": "https://example.com/a#logout", "includes": ["*"], "excludes": ["*logout*"], "expected": true, "note": "exclude does not see the fragment" },
    { "url": "https://example.com/", "includes": ["*"], "excludes": ["/./"], "expected": true, "note": "a regex exclude never excludes" },
    { "url": "https://example.com/", "includes": ["*"], "excludes": ["*"], "expected": false, "note": "exclude everything" },
    { "url": "https://example.com/", "matches": ["https://other.test/*"], "includes": ["https://example.com/*"], "expected": true, "note": "match or include" },
    { "url": "https://example.com/", "expected": false, "note": "no patterns" },
    { "url": "https://krunk.invalid/newtab.html", "includes": ["*"], "matches": ["<all_urls>"], "expected": false, "note": "never: krunk pages" },
    { "url": "https://shell.krunk.invalid/agent.html", "includes": ["*"], "expected": false, "note": "never: the shell" },
    { "url": "https://abcdefghijklmnopabcdefghijklmnop.ext.krunk.invalid/popup.html", "matches": ["*://*/*"], "expected": false, "note": "never: extension pages" },
    { "url": "https://Pages.KRUNK.invalid./x", "includes": ["*"], "expected": false, "note": "never: trailing dot and case" },
    { "url": "https://krunk.invalid.example.com/", "includes": ["*"], "expected": true, "note": "a real site that only starts like it" },
    { "url": "about:blank", "includes": ["*"], "expected": false, "note": "never: about:" },
    { "url": "data:text/html,hello", "includes": ["*"], "expected": false, "note": "never: data:" },
    { "url": "javascript:alert(1)", "includes": ["*"], "expected": false, "note": "never: javascript:" },
    { "url": "blob:https://example.com/0f6e", "includes": ["*"], "matches": ["<all_urls>"], "expected": false, "note": "never: blob:" },
    { "url": "chrome://settings/", "includes": ["*"], "expected": false, "note": "never: chrome:" },
    { "url": "devtools://devtools/bundled/inspector.html", "includes": ["*"], "expected": false, "note": "never: devtools:" },
    { "url": "ftp://example.com/file", "matches": ["ftp://example.com/*"], "includes": ["*"], "expected": false, "note": "never: ftp" },
    { "url": "not a url", "includes": ["*"], "expected": false, "note": "not an address" }
  ]
}
