# Build outputs (dist/ holds final deliverables: excluded from git, included in "Everything" downloads)
target/
build/
out/
bin/
obj/
dist/*
# ...except the update/download server's sources (Docker/Caddy, see dist/server/README.md)
!dist/server/
dist/server/releases/
node_modules/
.gradle/
.vs/
.idea/
*.o
*.obj
*.pdb
*.ilk
__pycache__/
*.pyc
# Tool caches
.serena/

# CEF spike / cross builds
spikes/*/target/
tools/*/target/

# Secrets (see .env.example)
.env
*.key
!core/tests/fixtures/update/test-signing.key

# Staging-only api settings (test keys, mail sink): read by api via an optional env_file, never
# committed, so never part of a live deploy (dist/server/README.md, "Testing accounts").
/staging.env

# Wallpaper originals (regenerated from assets/wallpapers/SOURCES.txt; the WebP files are in ui/shared/wallpapers/)
assets/wallpapers/originals/
