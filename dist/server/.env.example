# Copy to .env next to compose.yaml and adjust. Nothing secret belongs here: the update-signing
# key never goes on the server (publish-release.sh signs on your own machine).

# ":8080" serves plain HTTP (behind a reverse proxy, or for local tests).
# A domain name ("krunk.example.org") turns on automatic HTTPS with Let's Encrypt; the domain's
# DNS must point at this host and ports 80 and 443 must reach it.
SITE_ADDRESS=:8080

# Extra Caddy global options, e.g. a contact address for certificate notices:
# CADDY_GLOBAL_OPTIONS=email ops@example.org
CADDY_GLOBAL_OPTIONS=

# Host ports for compose.ports.yaml (80 and 443 with a domain).
HTTP_PORT=8080
HTTPS_PORT=8443

# ---- Account and sync API (docs/sync/PLAN.md §4.10, OPEN_QUESTIONS.md) ----
# The server's own secrets (database password, pepper, token and TOTP keys) are not set here:
# the secrets service creates them in the krunk-secrets volume on first start.
PUBLIC_BASE_URL=https://krunk.kruxsys.com
# The hop in front of Caddy whose CF-Connecting-IP is trusted (CIDRs, space-separated; Q8).
# Unset means 10.250.137.4/32 (ai-pipe's proxy for krunk.kruxsys.com); empty means none.
# TRUSTED_PROXIES_EXTRA=

# Accounts stay disabled until both Turnstile keys and SMTP_HOST are set (Q1, Q2). The widget's
# hostname must be the site's (default: PUBLIC_BASE_URL's host).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# TURNSTILE_EXPECTED_HOSTNAME=krunk.kruxsys.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# starttls (port 587) or tls (port 465)
SMTP_TLS=starttls
MAIL_FROM=Krunk <no-reply@krunk.kruxsys.com>

# Sync storage per account (0.9.0; OPEN_QUESTIONS Q5). Unset means the defaults shown.
# QUOTA_MAX_BYTES=52428800
# QUOTA_MAX_RECORDS=100000
# QUOTA_MAX_HISTORY=25000

# Staging and local tests do NOT go here: their test keys and mail sink go into the gitignored
# staging.env at the repository root (README.md, "Testing accounts"). Even if they end up here,
# Cloudflare's test secrets, SMTP_TLS=none and a staging PUBLIC_BASE_URL keep accounts closed
# without ACCOUNTS_TEST_MODE=1.
