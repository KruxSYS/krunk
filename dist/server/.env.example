# Copy to .env next to compose.yaml and adjust. Nothing secret belongs here: the update-signing
# key never goes on the server (publish-release.sh signs on your own machine).

# ":8080" serves plain HTTP (behind a reverse proxy, or for local tests).
# A domain name ("krunk.example.org") turns on automatic HTTPS with Let's Encrypt; the domain's
# DNS must point at this host and ports 80 and 443 must reach it.
SITE_ADDRESS=:8080

# Extra Caddy global options, e.g. a contact address for certificate notices:
# CADDY_GLOBAL_OPTIONS=email ops@example.org
CADDY_GLOBAL_OPTIONS=

# Host ports for compose.ports.yaml (80 and 443 with a domain).
HTTP_PORT=8080
HTTPS_PORT=8443

# ---- Account and sync API (docs/sync/PLAN.md §4.10, OPEN_QUESTIONS.md) ----
# The server's own secrets (database password, pepper, token and TOTP keys) are not set here:
# the secrets service creates them in the krunk-secrets volume on first start.
PUBLIC_BASE_URL=https://krunk.209.wf
# The hop in front of Caddy whose CF-Connecting-IP is trusted (CIDRs, space-separated; Q8).
# Unset means 10.250.137.4/32 (ai-pipe's proxy for krunk.209.wf); empty means none.
# TRUSTED_PROXIES_EXTRA=

# Accounts stay disabled until both Turnstile and SMTP are set (Q1, Q2; from milestone S2).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# starttls (port 587) or tls (port 465)
SMTP_TLS=starttls
MAIL_FROM=Krunk <no-reply@krunk.209.wf>
