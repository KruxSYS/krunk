# Copy to .env next to compose.yaml and adjust. Nothing secret belongs here: the update-signing
# key never goes on the server (publish-release.sh signs on your own machine).

# ":8080" serves plain HTTP (behind a reverse proxy, or for local tests).
# A domain name ("krunk.example.org") turns on automatic HTTPS with Let's Encrypt; the domain's
# DNS must point at this host and ports 80 and 443 must reach it.
SITE_ADDRESS=:8080

# Extra Caddy global options, e.g. a contact address for certificate notices:
# CADDY_GLOBAL_OPTIONS=email ops@example.org
CADDY_GLOBAL_OPTIONS=

# Host ports for compose.ports.yaml (80 and 443 with a domain).
HTTP_PORT=8080
HTTPS_PORT=8443

# ---- Account and sync API (docs/sync/PLAN.md §4.10) ----
# The api and db services start only with this profile. Leave it unset until the database
# location and the Cloudflare hop are decided (docs/sync/OPEN_QUESTIONS.md Q4, Q8).
# COMPOSE_PROFILES=sync
COMPOSE_PROFILES=

# Secrets: generate them with gen-server-secrets.sh (never commit .env).
POSTGRES_PASSWORD=
TOKEN_HMAC_KEY=
PASSWORD_PEPPER=
PASSWORD_PEPPER_ID=1
TOTP_ENC_KEY=

# Public settings.
PUBLIC_BASE_URL=https://krunk.209.wf
# Turnstile (OPEN_QUESTIONS Q1); used from milestone S2.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=krunk.209.wf
# The hop between Cloudflare and Caddy, if any (CIDRs, space-separated; OPEN_QUESTIONS Q8).
TRUSTED_PROXIES_EXTRA=
