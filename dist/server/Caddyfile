# Krunk website, downloads and update feed (see README.md).
#
# SITE_ADDRESS  ":8080" (default): plain HTTP on 8080, for a reverse proxy or local use.
#               "krunk.example.org": automatic HTTPS (Let's Encrypt) on 8443, HTTP->HTTPS on
#               8080; publish them as 443 and 80 (compose.ports.yaml).
# CADDY_GLOBAL_OPTIONS  extra global options, e.g. "email ops@example.org" for ACME notices.
# TRUSTED_PROXIES_EXTRA  the hop between Cloudflare and Caddy, if any (OPEN_QUESTIONS Q8); its
#               client-IP header is trusted like Cloudflare's own ranges.
{
	admin off
	http_port 8080
	https_port 8443
	# The client IP is CF-Connecting-IP only when the TCP peer is Cloudflare (or the configured
	# hop); otherwise the peer address itself. Ranges: update-cloudflare-ips.sh.
	servers {
		import cloudflare-trusted.caddy
		client_ip_headers CF-Connecting-IP
	}
	{$CADDY_GLOBAL_OPTIONS}
}

(security_headers) {
	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		# "?" = only where no route set its own (the Turnstile pages do). This block is deferred
		# (it deletes Server), so it runs after the routes' own headers.
		?Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		Cross-Origin-Resource-Policy "same-origin"
		Cross-Origin-Opener-Policy "same-origin"
		# Ignored by browsers over plain HTTP; applies when served over HTTPS.
		Strict-Transport-Security "max-age=31536000"
	}
}

# Every Cache-Control also says no-transform: a CDN in front (Cloudflare on the live site) must
# not rewrite responses, e.g. inject its analytics script into the HTML.
(krunk) {
	import security_headers
	encode zstd gzip

	handle /healthz {
		header Cache-Control "no-store, no-transform"
		respond "ok" 200
	}

	# The account and sync API (krunk-sync, service "api", docs/sync/PLAN.md §8). Never cached or
	# transformed. While api is down this answers a JSON 502.
	handle /api/* {
		request_body {
			max_size 2MiB
		}
		import cloudflare-untrusted.caddy
		request_header @untrusted_peer -CF-IPCountry
		header >Cache-Control "no-store, no-transform"
		reverse_proxy api:8081 {
			header_up X-Krunk-Client-IP {client_ip}
		}
	}

	# Krunk's update checks: always revalidated, so a new release is seen at once. Windows
	# (updates/win-x64/, publish-release.sh) and, since Android 0.5.0, the website APK
	# (updates/android-arm64/, publish-android.sh): latest.json and its Ed25519 latest.json.sig.
	handle /updates/* {
		root * /srv/releases
		header Cache-Control "no-cache, no-transform"
		@json path *.json
		header @json Content-Type "application/json"
		@sig path *.sig
		header @sig Content-Type "text/plain; charset=utf-8"
		file_server {
			hide .*
		}
	}

	# The website's download boxes (Windows, and Android since the Android 0.1.0 release).
	handle /download/release.json {
		root * /srv/releases
		header Cache-Control "no-cache, no-transform"
		header Content-Type "application/json"
		file_server {
			hide .*
		}
	}
	handle /download/android.json {
		root * /srv/releases
		header Cache-Control "no-cache, no-transform"
		header Content-Type "application/json"
		file_server {
			hide .*
		}
	}

	# Release files never change once published (a new version gets a new folder).
	handle /download/* {
		root * /srv/releases
		header Cache-Control "public, max-age=31536000, immutable, no-transform"
		# (Path wildcards only work at the start or the end.)
		@exe path *.exe
		header @exe Content-Type "application/octet-stream"
		@zip path *.zip
		header @zip Content-Type "application/zip"
		@apk path *.apk
		header @apk Content-Type "application/vnd.android.package-archive"
		@binary path *.exe *.zip *.apk
		header @binary Content-Disposition "attachment"
		@text path *.md */SHA256SUMS
		header @text Content-Type "text/plain; charset=utf-8"
		file_server {
			hide .*
		}
	}

	# The account pages (docs/sync/PLAN.md §4.6): static, never cached. Only the form pages
	# may load Cloudflare Turnstile, so only they allow its script and frame (PLAN §4.5):
	# sign-in, registration, password reset, resending the confirmation and (0.13.0) deletion.
	redir /account /account/ 308
	handle /account/* {
		root * /srv/site
		header Cache-Control "no-store, no-transform"
		@turnstile path /account/login /account/register /account/reset /account/resend /account/delete /account/login.html /account/register.html /account/reset.html /account/resend.html /account/delete.html
		header @turnstile Content-Security-Policy "default-src 'none'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self'; img-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		try_files {path} {path}.html
		file_server {
			hide .*
		}
	}

	# The device approval page (S3, PROTOCOL §6.1): Krunk opens /link?code=XXXX-XXXX. It needs a
	# website session already, so it never loads Turnstile: the default CSP applies.
	handle /link {
		root * /srv/site
		header Cache-Control "no-store, no-transform"
		rewrite * /account/link.html
		file_server
	}

	# "Add a device" by QR code (0.13.0): the phone opens /pair#<token>. The token stays in the
	# fragment, so it never reaches the server or a log; the page needs no Turnstile.
	handle /pair {
		root * /srv/site
		header Cache-Control "no-store, no-transform"
		rewrite * /account/pair.html
		file_server
	}

	handle /privacy {
		root * /srv/site
		header Cache-Control "no-cache, no-transform"
		rewrite * /privacy.html
		file_server
	}

	# Generated from CHANGELOG.md when the image is built (changelog.py render, Dockerfile).
	handle /changelog {
		root * /srv/site
		header Cache-Control "no-cache, no-transform"
		rewrite * /changelog.html
		file_server
	}

	# The site itself (baked into the image).
	handle {
		root * /srv/site
		header Cache-Control "no-cache, no-transform"
		file_server {
			hide .*
		}
	}

	# Error responses start with fresh headers, so they need the security headers again.
	handle_errors {
		import security_headers
		header Cache-Control "no-store, no-transform"
		@api_too_large {
			path /api/*
			expression {err.status_code} == 413
		}
		handle @api_too_large {
			header Content-Type "application/json"
			respond `{"error":"payload_too_large","message":"The request is too large."}` 413
		}
		@api path /api/*
		handle @api {
			header Content-Type "application/json"
			respond `{"error":"server_error","message":"The service is unavailable."}` {err.status_code}
		}
		# Downloads and the update feed answer as before: Krunk's updater and the download box
		# only look at the status.
		@feeds path /download/* /updates/* /healthz
		handle @feeds {
			respond "{err.status_code} {err.status_text}"
		}
		# The site's own pages (0.10.0): the same status, an HTML body in the site's look. They
		# are static files, so they work while api is down.
		@site_404 expression {err.status_code} == 404
		handle @site_404 {
			root * /srv/site
			rewrite * /404.html
			file_server {
				status 404
			}
		}
		@site_5xx expression {err.status_code} >= 500
		handle @site_5xx {
			root * /srv/site
			rewrite * /50x.html
			file_server {
				status {err.status_code}
			}
		}
		respond "{err.status_code} {err.status_text}"
	}
}

{$SITE_ADDRESS::8080} {
	import krunk
}

# The container's health check (also when SITE_ADDRESS is a domain).
http://127.0.0.1:8080 {
	import krunk
}
